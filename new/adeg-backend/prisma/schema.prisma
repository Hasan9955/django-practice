model Follow {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId String?  @db.ObjectId
  storeId    String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  follower User?  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  store    Store? @relation(fields: [storeId], references: [id])

  @@map("follows")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpCode   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model PlatformMangement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  currency       String[]
  commisionRate  Float?
  shippingPolicy String[]

  category   Category[]
  banner     Banner[]
  logo       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  CmsSetting CmsSetting[]

  @@map("platfromManagement")
}

model Group {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  groupImage   String
  description  String?        @default("")
  adminId      String         @db.ObjectId
  admin        User           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  members      UserGroup[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  groupMessage GroupMessage[]

  @@map("groups")
}

model UserGroup {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  groupId String @db.ObjectId

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
  @@map("user_groups")
}

model GroupMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String   @db.ObjectId
  senderId  String   @db.ObjectId
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  seenBy    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, senderId])
  @@map("group_message")
}

model PrivateMessage {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  senderId       String        @db.ObjectId
  receiverId     String        @db.ObjectId
  content        Json?
  offerId        String?       @db.ObjectId
  messageType    MessageType   @default(PRIVATEMESSAGE)
  imageUrl       String?
  conversationId String?       @db.ObjectId
  ticketId       String?       @db.ObjectId
  refundId       String?       @db.ObjectId
  read           Boolean       @default(false)
  sender         User?         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User?         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  Conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  B2BOffer       B2BOffer?     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  Ticket         Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  Refund         Refund?       @relation(fields: [refundId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("private_messages")
}

model Conversation {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  user1Id        String             @db.ObjectId
  user2Id        String             @db.ObjectId
  chatType       ChatType           @default(GENERAL)
  lastMessage    String?
  user1          User?              @relation("User1Convarsion", fields: [user1Id], references: [id], onDelete: Cascade)
  user2          User?              @relation("User2Convarsion", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  status         ConversationStatus @default(DEACTIVE)
  privateMessage PrivateMessage[]
  B2BOffer       B2BOffer[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

enum ChatType {
  GENERAL
  B2B
}

model Ticket {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  ticketName        String
  ticketDescription String
  priority          TicketPriority   @default(MEDIUM)
  department        TicketDepartment
  ticketStatus      TicketStatus     @default(NEW)
  tickerRole        UserRole
  ticketCreatorId   String?          @db.ObjectId
  ticketReceiverId  String?          @db.ObjectId
  ticketCreator     User?            @relation("ticketCreator", fields: [ticketCreatorId], references: [id], onDelete: Cascade)
  ticketReceiver    User?            @relation("ticketReceiver", fields: [ticketReceiverId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  privateMessage    PrivateMessage[]

  @@map("tickets")
}

model Refund {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String           @db.ObjectId
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundReason   String
  refundStatus   RefundStatus     @default(PENDING)
  customerId     String           @db.ObjectId
  sellerId       String           @db.ObjectId
  customer       User?            @relation("RefundCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  seller         User?            @relation("RefundSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  privateMessage PrivateMessage[]

  @@map("refunds")
}

model Promotion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  category       String
  isPublished    Boolean  @default(true)
  promotionImage String?
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("promotions")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Notifications {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String   @db.ObjectId
  body       String
  title      String
  user       User     @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  amount          Float
  isPaid          Boolean       @default(false)
  status          PaymentStatus @default(Paid)
  paymentIntentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Order           Order[]

  @@map("payments")
}

model Order {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?   @db.ObjectId
  storeId         String?   @db.ObjectId
  variantId       String?   @db.ObjectId
  name            String?
  phoneNumber     String?
  currency        String
  bundleId        String?   @db.ObjectId
  orderNumber     String    @unique
  region          String    @default("Other")
  country         String?
  state           String?
  city            String?
  zipCode         String?
  deliveryAddress String?
  isPaid          Boolean   @default(false)
  orderStatus     OrderEnum @default(Pending)
  price           Float     @default(0.0)
  deliveryFee     Float     @default(0.0)
  quantity        Int       @default(0)
  paymentId       String    @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isReviewed      Boolean   @default(false)

  //relation
  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant Varient?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bundle  BundleOffer? @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  Refund  Refund[]

  @@map("orders")
}

model NicheHub {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @db.ObjectId
  productId    String?    @db.ObjectId
  title        String
  fileUrl      String[]
  isPublished  Boolean    @default(true)
  commentCount Int        @default(0)
  likeCount    Int        @default(0)
  shareCount   Int        @default(0)
  visibility   Visibility @default(ALL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  Like            Like[]
  Comment         Comment[]
  Poll            Poll[]
  Share           Share[]
  reportNicheHubs ReportNicheHub[]

  @@map("nicheHub")
}

model ReportNicheHub {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  nicheHubId   String       @db.ObjectId
  userId       String       @db.ObjectId
  reason       String
  reasonType   ReasonType
  reportStatus ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  nicheHub NicheHub @relation(fields: [nicheHubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nicheHubId, userId])
  @@map("reportNicheHub")
}

enum ReasonType {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model Poll {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  nicheHubId String       @db.ObjectId
  question   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  nicheHub   NicheHub     @relation(fields: [nicheHubId], references: [id], onDelete: Cascade)
  options    PollOption[]
  PollVote   PollVote[]

  @@map("polls")
}

model PollOption {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String     @db.ObjectId
  text      String
  voteCount Int        @default(0)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@map("pollsOptions")
}

model PollVote {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String     @db.ObjectId
  optionId  String     @db.ObjectId
  userId    String     @db.ObjectId
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("pollVotes")
}

model Like {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  nicheHubId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicheHub   NicheHub @relation(fields: [nicheHubId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, nicheHubId])
  @@map("likes")
}

model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  nicheHubId String?  @db.ObjectId
  userId     String?  @db.ObjectId
  parentId   String?  @db.ObjectId
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nicheHub NicheHub? @relation(fields: [nicheHubId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  parent   Comment?  @relation("CommentToReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentToReplies")

  @@map("comments")
}

model Share {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  nicheHubId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicheHub   NicheHub @relation(fields: [nicheHubId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("shares")
}

model B2BOffer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String?       @db.ObjectId
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  offerStuts           OfferStatus       @default(PENDING)
  isDelivered          Boolean           @default(false)
  buyerId              String            @db.ObjectId
  buyer                User?             @relation("buyerInfo", references: [id], fields: [buyerId], onDelete: Cascade)
  sellerId             String            @db.ObjectId
  seller               User?             @relation("sellerInfo", references: [id], fields: [sellerId], onDelete: Cascade)
  expectedDeliveryDate DateTime
  totalPrice           Float             @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  offer_Items          B2B_Offer_Items[]
  PrivateMessage       PrivateMessage[]

  @@map("offer")
}

model B2B_Offer_Items {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productId String  @db.ObjectId
  product   Product @relation(references: [id], fields: [productId], onDelete: Cascade)

  offerId String   @db.ObjectId
  offer   B2BOffer @relation(references: [id], fields: [offerId], onDelete: Cascade)

  unitPrice Float
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offer_items")
}

model Withdraw {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String         @db.ObjectId
  amount      Float          @default(0.0)
  bankName    String
  accountNo   String
  accountName String
  sortCode    String?
  status      WithdrawStatus @default(Pending)
  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("withdraws")
}

model Subscription {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  pricingId        String?            @unique
  productId        String?            @unique
  heading          String?
  interval         IntervalType
  interval_count   Int
  price            Float
  off              Float              @default(0.0)
  title            String
  type             SubscriptionType
  isActive         Boolean            @default(true)
  features         Json               @db.Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  UserSubscription UserSubscription[]

  @@map("subscription")
}

model UserSubscription {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  userId            String             @unique @db.ObjectId
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?            @db.ObjectId
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  priceId           String?
  startDate         DateTime?
  endDate           DateTime?
  subscriptionPayId String?            
  status            SubscriptionStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, subscriptionId])
  // @@unique([userId, priceId])
  @@map("userSubscription")
}

model ProductFaq {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productFaq")
}

model StoreSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId   String   @db.ObjectId
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userEmail String
  userId    String?  @unique @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storeSubscribers")
}

