datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  socialLoginType SOCIALLOGINTYPES @default(EMAIL_PASSWORD)
  fullName        String
  location        String?
  email           String           @unique

  role            UserRole @default(USER)
  password        String?  @default("")
  companyName     String?
  phoneNumber     String?
  deliveryAddress String?
  zipCode         String?
  city            String?
  state           String?
  profileImage    String   @default("")
  coverPhoto      String   @default("")
  customerId      String?
  rewardPoint     Int      @default(0)

  sentMessages     PrivateMessage[] @relation("SentMessages")
  receivedMessages PrivateMessage[] @relation("ReceivedMessages")

  ticketCreator  Ticket[] @relation("ticketCreator")
  ticketReceiver Ticket[] @relation("ticketReceiver")

  RefundCustomer Refund[] @relation("RefundCustomer")
  RefundSeller   Refund[] @relation("RefundSeller")

  user1Convarsion Conversation[] @relation("User1Convarsion")
  user2Convarsion Conversation[] @relation("User2Convarsion")

  admin       Admin?
  isOtpVerify Boolean @default(false)
  isProfile   Boolean @default(false)

  Notifications      Notifications[]
  reciveNotificaiton Boolean         @default(false)
  fcmToken           String?
  isSubscription     Boolean         @default(false)

  status UserStatus @default(ACTIVE)
  Otp    Otp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Profile   Profile?
  isDeleted Boolean  @default(false)

  Group        Group[]
  UserGroup    UserGroup[]
  GroupMessage GroupMessage[]
  store        Store[]
  Cart         Cart[]
  review       Review[]
  View         View[]
  Order        Order[]
  NicheHub     NicheHub[]
  Like         Like[]
  Comment      Comment[]
  PollVote     PollVote[]
  Share        Share[]
  Follower     Follow[]       @relation("Follower")
  cutomerOffer B2BOffer[]     @relation("buyerInfo")
  sellerOffer  B2BOffer[]     @relation("sellerInfo")

  Withdraw         Withdraw[]
  UserSubscription UserSubscription?
  StoreSubscriber  StoreSubscriber?
  reportNicheHubs  ReportNicheHub[]

  userBlocked BlockUser[] @relation("blockedBy") // This user blocks others
  blockedUser BlockUser[] @relation("blocked") // Others block this user

  @@map("users")
}

// Add to your prisma schema

model EmailSuppression {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  reason         String // PERMANENT_BOUNCE, SPAM_COMPLAINT, MANUAL
  diagnosticCode String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("email_suppressions")
}

model BlockUser {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  blockedId String @db.ObjectId

  blockedBy User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "blockedBy")
  blocked   User @relation(fields: [blockedId], references: [id], onDelete: Cascade, name: "blocked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @unique @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile")
}

model Admin {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  nickName String @unique
  password String
  email    String @unique
  userId   String @unique @db.ObjectId
  user     User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Banner {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  bannerUrl   String
  title       String
  redirectUrl String?
  description String
  platformId  String            @db.ObjectId
  platform    PlatformMangement @relation(references: [id], fields: [platformId])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("banners")
}

model CmsSetting {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  bannerImage String?
  redirectUrl String?
  title       String?
  aboutUs     String?

  platformId    String            @unique @db.ObjectId
  platform      PlatformMangement @relation(references: [id], fields: [platformId])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  faq           Faq[]
  footer        Footer?
  privacyPolicy PrivacyPolicy?

  @@map("cmsSetting")
}

model Footer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyInfo        String?
  news               String?
  invertors          String?
  polices            String?
  registration       String?
  moneyBackGuarantee String?
  seamlessBuying     String?
  sellerAccount      String?
  learnToSell        String?
  facebookUrl        String?
  twitterUrl         String?
  instagramUrl       String?
  linkedInUrl        String?
  youtubeUrl         String?
  contactEmail       String?
  contactPhone       String?
  contactAddress     String?

  cmsSettingId String     @unique @db.ObjectId
  cms          CmsSetting @relation(references: [id], fields: [cmsSettingId], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("footer")
}

model Faq {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  question     String
  answer       String
  cmsSettingId String     @db.ObjectId
  cms          CmsSetting @relation(references: [id], fields: [cmsSettingId])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("faq")
}

model PrivacyPolicy {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  content      String
  cmsSettingId String     @unique @db.ObjectId
  cms          CmsSetting @relation(references: [id], fields: [cmsSettingId])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("privacyPolicy")
}

model Cart {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  productId String       @db.ObjectId
  variantId String       @db.ObjectId
  bundleId  String?      @db.ObjectId
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  variant   Varient      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bundle    BundleOffer? @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@map("cart")
}

model Category {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  name          String            @unique
  displayName   String
  categoryPhoto String?
  isDeleted     Boolean           @default(false)
  platformId    String            @db.ObjectId
  platform      PlatformMangement @relation(references: [id], fields: [platformId])
  parentId      String?           @db.ObjectId
  ancestors     String[]          @db.ObjectId

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  product   Product[]
  Attribute Attribute[]

  @@map("categories")
}

model Attribute {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       AttributeType
  isRequired Boolean          @default(false)
  categoryId String           @db.ObjectId
  category   Category         @relation(fields: [categoryId], references: [id])
  values     AttributeValue[]
}

model AttributeValue {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  value       String
  isApproved  Boolean   @default(false)
  attributeId String    @db.ObjectId
  attribute   Attribute @relation(fields: [attributeId], references: [id])
}

model Product {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  productName       String
  basePrice         Float         @default(0)
  discountPrice     Float         @default(0)
  totalView         Int           @default(0)
  discountStartDate DateTime
  discountEndTime   DateTime
  desc              String
  productDetails    String
  avgRating         Float         @default(0)
  totalSale         Int           @default(0)
  isPublished       Boolean       @default(true)
  productPhoto      String[]
  searchTag         String[]
  isDeleted         Boolean       @default(false)
  productStatus     ProductStatus @default(NewArrival)
  categoryId        String        @db.ObjectId
  category          Category?     @relation(references: [id], fields: [categoryId], onDelete: Cascade)
  storeId           String        @db.ObjectId
  shop              Store         @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  B2BPackage        B2BPackage[]
  BundleOffer       BundleOffer[]
  Cart              Cart[]
  Varient           Varient[]
  Review            Review[]
  View              View[]

  Offer_Items B2B_Offer_Items[]
  productFaq  ProductFaq[]
  nicheHubs   NicheHub[]

  @@map("products")
}

model View {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("views")
}

model Varient {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  sku            String
  stock          Int
  price          Float
  attributes     Json
  productId      String          @db.ObjectId
  product        Product         @relation(references: [id], fields: [productId], onDelete: Cascade)
  varientCoupons VarientCoupon[]
  Cart           Cart[]
  Order          Order[]

  @@map("varient")
}

model Coupon {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  code           String          @unique
  storeId        String?         @db.ObjectId
  discountType   DiscountType
  discountValue  Float
  validFrom      DateTime
  validTill      DateTime
  store          Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  varientCoupons VarientCoupon[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("coupon")
}

model VarientCoupon {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  varientId String  @db.ObjectId
  couponId  String  @db.ObjectId
  varient   Varient @relation(fields: [varientId], references: [id], onDelete: Cascade)
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([varientId, couponId])
  @@map("varient_coupon")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float
  comment   String
  image     String[]
  video     String?
  productId String?  @db.ObjectId
  userId    String?  @db.ObjectId
  product   Product? @relation(references: [id], fields: [productId])
  user      User?    @relation(references: [id], fields: [userId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model B2BPackage {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  quantity      String
  price         Float
  moq           Int        @default(1)
  maxMOQ        Int?
  pricePerUnit  Float      @default(0)
  b2bPackageTag PackageTag @default(SmallSupply)
  productId     String     @db.ObjectId
  product       Product    @relation(references: [id], fields: [productId], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("b2bPackage")
}

enum PackageTag {
  SmallSupply
  MediumSupply
  LargeSupply
}

model BundleOffer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  discount  Float
  bundleTag String
  productId String   @db.ObjectId
  product   Product  @relation(references: [id], fields: [productId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Cart      Cart[]
  Order     Order[]

  @@map("bundleOffer")
}

model Store {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  bannerImage   String
  name          String
  slug          String      @unique
  shopName      String
  desc          String
  phoneNumber   String
  totalWithdraw Float       @default(0.0)
  followers     Int         @default(0)
  followings    Int         @default(0)
  email         String
  shopLogo      String
  status        storeStatus @default(Pending)
  sellerId      String      @unique @db.ObjectId
  seller        User        @relation(references: [id], fields: [sellerId], onDelete: Cascade)

  country String?
  city    String?
  address String?
  zipcode String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Product          Product[]
  Coupon           Coupon[]
  Order            Order[]
  Follow           Follow[]
  shippingOption   ShippingOption?
  storeSubscribers StoreSubscriber[]

  @@map("store")
}

model ShippingOption {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  shippingZone     String
  freeShippingZone String
  storeId          String @unique @db.ObjectId
  store            Store  @relation(references: [id], fields: [storeId], onDelete: Cascade)

  insideCityRate        Float?
  outsideCityRate       Float?
  // freeAreaRate    Float?
  isFreeShippingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // shippingRates     shippingRate[]
  // logisticsPartners logisticsPartner[]

  @@map("shippingOptions")
}

